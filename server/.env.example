# Copy to .env and fill in. Every integration is optional: leave a block blank
# and that section of the site goes quiet without affecting the others.
# See README.md for where each of these comes from.

PORT=3000

# Comma-separated origins allowed to read from the browser. Blank allows any.
# localhost is allowed on top of this unless NODE_ENV=production, so listing
# only the deployed site here does not lock you out of your own dev server.
ALLOWED_ORIGINS=https://alex.wohlbruck.com

# --- Guestbook database -------------------------------------------------------
# Pooled Postgres connection string. Neon provides this on the Connect screen.
DATABASE_URL=

# --- Spotify -----------------------------------------------------------------
# developer.spotify.com/dashboard, then `npm run auth:spotify`.
# The redirect URI must be https or the literal loopback address below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=

# --- Instagram ---------------------------------------------------------------
# developers.facebook.com, Instagram > API setup with Instagram business login.
# Needs a Creator or Business account. Then `npm run auth:instagram`.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=

# --- Google Calendar ---------------------------------------------------------
# A service account key from console.cloud.google.com, with the calendar shared
# to its address at "See only free/busy". Keep the \n escapes in the key.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Google Analytics --------------------------------------------------------
# GA4 property id (not the G- measurement id). The service account above needs
# Viewer access to the property and Analytics Data API enabled in its project.
GOOGLE_ANALYTICS_PROPERTY_ID=284914213

# --- Contact form ------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
# Where the form sends to. Defaults to MAIL_USER.
MAIL_TO=
